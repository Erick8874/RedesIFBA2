{
  "uid": "cafe-negocio",
  "title": "Café Planalto - Negócio e SLOs",
  "tags": ["cafeplanalto", "negocio", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Pedidos por minuto",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "60 * rate(pedidos_criados_total[5m])", "refId": "A", "legendFormat": "pedidos/min"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"showLegend": false}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Faturamento por minuto (R$)",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "60 * rate(pedidos_valor_reais_total[5m])", "refId": "A", "legendFormat": "R$/min"}],
      "fieldConfig": {"defaults": {"unit": "currencyBRL"}, "overrides": []},
      "options": {"legend": {"showLegend": false}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "SLO disponibilidade (7 dias) - orçamento restante (99,5%)",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "clamp_min(1 - ((1 - avg_over_time((probe_success{job=\"blackbox-http-filial\",alvo=\"loja\"} or on(job,instance) (up{job=\"blackbox-http-filial\"} * 0))[7d:15s])) / 0.005), 0) * 100",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 20}, {"color": "green", "value": 50}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showThresholdLabels": true, "showThresholdMarkers": true}
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "SLO latência (7 dias) - orçamento restante (95% abaixo de 300 ms)",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "clamp_min(1 - ((1 - (sum(increase(http_request_duration_seconds_bucket{le=\"0.3\"}[7d])) / clamp_min(sum(increase(http_request_duration_seconds_count[7d])), 1))) / 0.05), 0) * 100",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 20}, {"color": "green", "value": 50}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showThresholdLabels": true, "showThresholdMarkers": true}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Disponibilidade observada (7 dias, sonda da filial)",
      "gridPos": {"x": 0, "y": 17, "w": 12, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "100 * avg_over_time((probe_success{job=\"blackbox-http-filial\",alvo=\"loja\"} or on(job,instance) (up{job=\"blackbox-http-filial\"} * 0))[7d:15s])",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area", "textMode": "auto"}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Latência p95 da API (7 dias, meta < 300 ms)",
      "gridPos": {"x": 12, "y": 17, "w": 12, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le) (increase(http_request_duration_seconds_bucket[7d])))",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area", "textMode": "auto"}
    }
  ],
  "time": {"from": "now-7d", "to": "now"}
}
